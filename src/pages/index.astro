---
import Layout from "../layouts/Layout.astro";
import { STAGES } from "../scripts/main";
---

<Layout title="The Shine Is Made of Time">
  <header>
    <nav aria-label="Primary">
      <a href="./">Home</a>
    </nav>
  </header>
  <main>
    <h1>The Shine Is Made of Time</h1>
    <p>
      Drag the bead left and right to work it through the stages of Chinese
      lacquer work, from a raw blank to a finished, polished shine.
    </p>
    <div class="interaction">
      <div class="bead-wrap">
        <div class="drag-hint" aria-hidden="true">
          <span class="drag-hint-ring"></span>
          <span class="drag-hint-ring drag-hint-ring-delay"></span>
          <span class="drag-hint-label">Drag</span>
        </div>
        <div
          class="bead"
          data-testid="bead"
          data-stage={STAGES[0].id}
          role="img"
          aria-label="A lacquer bead, its surface changing as progress advances"
        >
          {STAGES.map((stage) => (
            <img class="bead-layer" data-stage={stage.id} src={stage.image.src} alt="" />
          ))}
        </div>
      </div>
      <p class="stage-label" data-testid="stage-label">{STAGES[0].label}</p>
      <div class="stage-dots" data-testid="stage-dots">
        {STAGES.map((stage) => (
          <span class="stage-dot" data-stage={stage.id}></span>
        ))}
      </div>
      <input
        type="range"
        min="0"
        max="100"
        value="0"
        data-testid="progress"
        aria-label="Manufacturing progress"
        class="visually-hidden"
      />
    </div>
  </main>
  <script src="../scripts/main.ts"></script>
</Layout>
